# NoteForge AI - supported environment variables (reference only).
#
# NoteForge AI does NOT load .env files. These are ordinary operating-system environment
# variables, read only when the optional Ollama backend is used. Set them in Windows
# PowerShell before starting the program, for the current window only, for example:
#
#   $env:OLLAMA_MODEL = "qwen3.5:4b"
#   $env:OLLAMA_TIMEOUT = "1800"
#   python src/main.py
#
# Nothing here is required: every variable is optional and the values below are the defaults.
# The Local backend (the default) needs no configuration at all. Other settings are chosen in
# the program's menu or with the --output-dir command-line option.
# No paid service can be reached from the program, and no OPENAI_* variable is read.

# Address of the Ollama server. Only this machine is accepted: a non-loopback address is
# refused so that article text cannot leave your computer.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama's own variable name, accepted as a fallback when OLLAMA_BASE_URL is not set
# (if both are set and differ, OLLAMA_BASE_URL wins). Leave it commented out unless needed.
# OLLAMA_HOST=127.0.0.1:11434

# Model used when Ollama is selected (the menu can change it). The validated model is
# qwen3.5:4b. If this variable is not set the program starts with qwen3.5:4b.
OLLAMA_MODEL=qwen3.5:4b

# Context window in tokens: an integer from 2048 to 32768. Larger values use more memory.
# 8192 uses about 3.1 GB with qwen3.5:4b (measured on a 16 GB CPU-only PC).
OLLAMA_NUM_CTX=8192

# Sampling temperature from 0 to 0.3 (low, so the notes follow the article).
OLLAMA_TEMPERATURE=0.2

# true, false or default. false = routine generation (Qwen 3.5 thinks by default and is far slower).
OLLAMA_THINK=false

# How long the model stays loaded between requests, for example 10m, 30s, 1h, 0 or -1.
OLLAMA_KEEP_ALIVE=10m

# Maximum tokens per reply: 64 to 4096, and less than half of OLLAMA_NUM_CTX.
OLLAMA_MAX_OUTPUT_TOKENS=1500

# Seconds to wait for one reply (a positive number).
OLLAMA_TIMEOUT=900
